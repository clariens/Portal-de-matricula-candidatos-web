{
  "name": "portal-matricula-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@tesseract.js-data/por": "1.0.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "openapi-typescript": "7.4.1",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
