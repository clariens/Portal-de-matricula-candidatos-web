# Modo da integração: "mock" (fixtures do protótipo, sem Lyceum) ou "techne" (API REST Techne v2 real)
LYCEUM_MODE=mock

# --- API Lyceum Techne v2 (somente backend; NUNCA usar prefixo VITE_*) ---
LYCEUM_API_BASE_URL=https://tst-lyceum.clariens.com.br/api
LYCEUM_API_BASIC_USER=
LYCEUM_API_BASIC_PASSWORD=
# Login do candidato: "techne" (POST /v2/pessoas/autenticacao, só ALUNO por RA) ou
# "legado" (j_security_check do Processo Seletivo, aceita candidato por CPF/e-mail; só valida a senha)
LYCEUM_AUTH_MODO=techne
LYCEUM_LEGADO_BASE_URL=https://desenvolvimento-lyceum.clariens.com.br/processo-seletivo
# Envio final dos documentos (POST /r/uploadDocumentosPorProcesso) FINALIZA a inscrição no Lyceum:
# "simular" valida e registra sem enviar (use em DEV); "enviar" envia de verdade.
LYCEUM_DOCUMENTOS_MODO=simular
# Timeouts em segundos
LYCEUM_TIMEOUT_LEITURA=20
LYCEUM_TIMEOUT_UPLOAD=60

# --- Sessão do portal (cookie httpOnly assinado) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SESSION_SECRET=troque-este-segredo
PORTAL_SESSION_HORAS=12
# false apenas em desenvolvimento local sem HTTPS
PORTAL_COOKIE_SECURE=false

# Origens permitidas (desenvolvimento). Em produção o front é servido pelo próprio BFF.
PORTAL_CORS_ORIGINS=http://localhost:5173

# Upload de documentos
PORTAL_UPLOAD_MAX_MB=10

# --- Conferência de documentos com IA (Claude) — somente backend; nunca no front ---
# Sem chave (ou IA_DOCUMENTOS_ATIVA=false) a conferência é feita no navegador (OCR local, fraco para fotos).
# LGPD: RG traz foto e digital (dados biométricos). Produção só com aval do IA CoE/DPO.
ANTHROPIC_API_KEY=
IA_DOCUMENTOS_ATIVA=false
IA_DOCUMENTOS_MODELO=claude-opus-5-5
IA_DOCUMENTOS_ESFORCO=low
IA_DOCUMENTOS_MAX_PX=2000
IA_DOCUMENTOS_CONCORRENCIA=4
# acima do teto diário a IA pausa e os documentos vão para conferência manual
IA_DOCUMENTOS_LIMITE_DIARIO_USD=20
IA_DOCUMENTOS_TENTATIVAS_POR_DOCUMENTO=8
