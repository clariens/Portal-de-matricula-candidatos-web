{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "front": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "bff": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,scripts/**,openapi.json,.env,.env.example}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "bff" } },
    { "source": "/(.*)", "destination": { "service": "front" } }
  ]
}
